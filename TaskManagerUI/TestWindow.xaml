<Window x:Class="TaskManagerUI.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helpers="clr-namespace:TaskManagerUI.Helpers"
        xmlns:controls="clr-namespace:TaskManagerUI.Controls.Components"
        mc:Ignorable="d"
        Title="TaskFlow - LevelIcons Test"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Grid Background="#1E1E1E">
        <!-- لون خلفية لتوضيح ظهور الأيقونات والشارات -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="معاينة جميع مستويات الشارات (LevelIcons)" 
                           Foreground="White" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Beginner -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Beginner: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Beginner"/>
                </StackPanel>

                <!-- Explorer -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Explorer: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Explorer"/>
                </StackPanel>

                <!-- Builder -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Builder: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Builder"/>
                </StackPanel>

                <!-- Achiever -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Achiever: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Achiever"/>
                </StackPanel>

                <!-- Expert -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Expert: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Expert"/>
                </StackPanel>

                <!-- Master -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Master: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Master"/>
                </StackPanel>

                <!-- Legend -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Legend: " Foreground="White" Width="100" VerticalAlignment="Center" FontSize="14"/>
                    <controls:LevelIcon Level="Legend"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>