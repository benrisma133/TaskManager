<UserControl x:Class="TaskManagerUI.Pages.Projects.ProjectInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:components="clr-namespace:TaskManagerUI.Controls.Components"
             mc:Ignorable="d">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══ -->
        <Border Grid.Row="0"
                Padding="24,16"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back -->
                <Button x:Name="BackBtn" Grid.Column="0"
                        Cursor="Hand" BorderThickness="0"
                        Background="Transparent"
                        Click="BackBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:IconImage Icon="ArrowLeft" x:Name="BackIcon"
                                                  Width="14" Height="14"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  Margin="0,0,8,0"/>
                                    <TextBlock Text="Back to Projects" x:Name="BackText"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter TargetName="BackIcon" Property="Foreground" Value="White"/>
                                    <Setter TargetName="BackText" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Right buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <!-- Edit -->
                    <Button x:Name="EditBtn"
                            Cursor="Hand" BorderThickness="0"
                            Background="Transparent"
                            Margin="0,0,8,0"
                            Click="EditBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent"
                                        CornerRadius="8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <fa:IconImage Icon="Pen" x:Name="EditIcon"
                                                      Width="14" Height="14"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      Margin="0,0,8,0"/>
                                        <TextBlock Text="Edit" x:Name="EditText"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource AccentHoverBrush}"/>
                                        <Setter TargetName="EditIcon" Property="Foreground" Value="White"/>
                                        <Setter TargetName="EditText" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Mark as Done -->
                    <Button x:Name="DoneBtn"
                            Cursor="Hand" BorderThickness="0"
                            Background="Transparent"
                            Click="DoneBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent"
                                        CornerRadius="8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <fa:IconImage Icon="Check" x:Name="DoneIcon"
                                                      Width="14" Height="14"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      Margin="0,0,8,0"/>
                                        <TextBlock Text="Mark as Done" x:Name="DoneText"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource SuccessBrush}"/>
                                        <Setter TargetName="DoneIcon" Property="Foreground" Value="White"/>
                                        <Setter TargetName="DoneText" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20">

                <!-- ── PROJECT HEADER CARD ── -->
                <Border x:Name="HeaderCard"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category icon -->
                        <Border x:Name="IconBg"
                                Width="44" Height="44"
                                CornerRadius="10"
                                Padding="10"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,0,16,0"
                                Background="{DynamicResource AccentBrush}">

                            <!-- CHANGED: Removed Canvas+ScaleTransform, using simple Viewbox with Stretch -->
                            <Viewbox>
                                <!-- CHANGED: Fill=White so icon is always visible on colored background -->
                                <!-- CHANGED: ElementName=Root for reliable binding instead of AncestorType -->
                                <!-- CHANGED: Added Stretch=Uniform so icon scales correctly -->
                                <Path x:Name="IconPath"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Data="{StaticResource IconWeb}"/>
                            </Viewbox>

                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ProjectTitleText"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="CategoryNameText"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>

                            <!-- Badges -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0"
                                            x:Name="BadgesPanel">
                                    <components:StatusBadge x:Name="StatusBadgeControl"
                                                            Margin="0,0,6,0"/>
                                    <components:PriorityBadge x:Name="PriorityBadgeControl"
                                                              Margin="0,0,6,0"/>
                                    <Border x:Name="DueDateBadge"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" Padding="10,4"
                                            Margin="0,0,6,0">
                                        <TextBlock x:Name="DueDateText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Border x:Name="DaysLeftBadge"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" Padding="10,4"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="DaysLeftText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Description -->
                            <Border x:Name="DescriptionPanel"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0" Padding="0,12,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DescriptionText"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── STATS ROW ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="16,14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Total Tasks" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TotalTasksText" FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="16,14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Completed" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="CompletedTasksText" FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="16,14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="In Progress" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="InProgressTasksText" FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Points Earned" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="PointsEarnedText" FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── PROGRESS CARD ── -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ChartSimple"
                                              Width="13" Height="13"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              Margin="0,0,6,0"/>
                                <TextBlock Text="Progress"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ProgressPercentText"
                                       Grid.Column="1"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <components:ProgressBar x:Name="ProgressBarControl"
                                                ProgressWidth="0"/>
                        <TextBlock x:Name="ProgressSubText"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── TWO COLUMN ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Task list -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <fa:IconImage Icon="ListCheck"
                                              Width="13" Height="13"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              Margin="0,0,6,0"/>
                                <TextBlock Text="Tasks"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="TaskListPanel"/>
                            <TextBlock x:Name="NoTasksText"
                                       Text="No tasks found."
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT: Points log + Time summary -->
                    <StackPanel Grid.Column="2">

                        <!-- Points log -->
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <fa:IconImage Icon="Star"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  Margin="0,0,6,0"/>
                                    <TextBlock Text="Points Log"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="PointsLogPanel"/>
                                <TextBlock x:Name="NoPointsText"
                                           Text="No points earned yet."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Time summary -->
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <fa:IconImage Icon="Clock"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  Margin="0,0,6,0"/>
                                    <TextBlock Text="Time Logged"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TotalTimeText"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="across all sessions"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,14"/>
                                <StackPanel x:Name="TimelinePanel"/>
                                <TextBlock x:Name="NoTimeText"
                                           Text="No sessions logged yet."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>