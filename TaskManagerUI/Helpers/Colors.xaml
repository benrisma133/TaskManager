<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ACCENT -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentLightBrush"   Color="#1E3A5F"/>

    <!-- BACKGROUND -->
    <SolidColorBrush x:Key="AppBackgroundBrush"       Color="#0F0F1A"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush"   Color="#1A1A2E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="#1E1E2E"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#252538"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"     Color="#252538"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"    Color="#16162A"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush"     Color="#1E1E2E"/>

    <!-- TEXT -->
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#64748B"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"    Color="#FFFFFF"/>

    <!-- BORDER -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#2D2D44"/>
    <SolidColorBrush x:Key="BorderHoverBrush"   Color="#3B82F6"/>
    <SolidColorBrush x:Key="BorderFocusBrush"   Color="#3B82F6"/>
    <SolidColorBrush x:Key="BorderErrorBrush"   Color="#EF4444"/>

    <!-- STATUS -->
    <SolidColorBrush x:Key="SuccessBrush"      Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#78350F"/>
    <SolidColorBrush x:Key="ErrorBrush"        Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorLightBrush"   Color="#7F1D1D"/>
    <SolidColorBrush x:Key="InfoBrush"         Color="#3B82F6"/>
    <SolidColorBrush x:Key="InfoLightBrush"    Color="#1E3A5F"/>

    <!-- MENU -->
    <SolidColorBrush x:Key="MenuNormalBrush"           Color="#1A1A2E"/>
    <SolidColorBrush x:Key="MenuHoverBrush"            Color="#252538"/>
    <SolidColorBrush x:Key="MenuActiveBrush"           Color="#1E3A5F"/>
    <SolidColorBrush x:Key="MenuActiveForegroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="MenuNormalForegroundBrush" Color="#F1F5F9"/>

    <!-- SCROLLBAR -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2D2D44"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent"/>

    <!-- SHADOW -->
    <!-- <Color x:Key="ShadowColor">#C39BD3</Color> -->
    <SolidColorBrush x:Key="CardShadowBrush" Color="#25C39BD3"/>
    <!-- Purple glow in dark -->

    <!-- PRIORITY -->
    <SolidColorBrush x:Key="PriorityHighBrush"      Color="#FF6B35"/>
    <SolidColorBrush x:Key="PriorityHighLightBrush" Color="#4A1F0A"/>


    <!-- TIMER BUTTON -->
    <SolidColorBrush x:Key="TimerPlayBrush"        Color="#3B82F6"/>
    <SolidColorBrush x:Key="TimerPlayHoverBrush"   Color="#2563EB"/>
    <SolidColorBrush x:Key="TimerPlayPressedBrush" Color="#1D4ED8"/>

    <SolidColorBrush x:Key="TimerPauseBrush"        Color="#F59E0B"/>
    <SolidColorBrush x:Key="TimerPauseHoverBrush"   Color="#D97706"/>
    <SolidColorBrush x:Key="TimerPausePressedBrush" Color="#B45309"/>

    <SolidColorBrush x:Key="TimerStopBrush"        Color="#EF4444"/>
    <SolidColorBrush x:Key="TimerStopHoverBrush"   Color="#DC2626"/>
    <SolidColorBrush x:Key="TimerStopPressedBrush" Color="#B91C1C"/>


    <!-- Timer brushes -->
    <SolidColorBrush x:Key="RingTrackBrush" Color="#E0E0E0"/>

    <!-- Dark.xaml -->
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#252525"/>

    <!-- Shimmer -->
    <Color x:Key="ShimmerBaseColor">#2A2A2A</Color>
    <Color x:Key="ShimmerHighColor">#3A3A3A</Color>


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  LEVEL BADGE COLORS                                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Beginner (Green) -->
    <SolidColorBrush x:Key="Level.Beginner.Background" Color="#F1F8E9"/>
    <SolidColorBrush x:Key="Level.Beginner.Border"     Color="#AED581"/>
    <SolidColorBrush x:Key="Level.Beginner.Shadow"     Color="#8BC34A"/>
    <SolidColorBrush x:Key="Level.Beginner.Icon"       Color="#558B2F"/>

    <!-- Explorer (Blue) -->
    <SolidColorBrush x:Key="Level.Explorer.Background" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="Level.Explorer.Border"     Color="#64B5F6"/>
    <SolidColorBrush x:Key="Level.Explorer.Shadow"     Color="#2196F3"/>
    <SolidColorBrush x:Key="Level.Explorer.Ring"       Color="#BBDEFB"/>
    <SolidColorBrush x:Key="Level.Explorer.Icon"       Color="#1565C0"/>

    <!-- Builder (Orange) -->
    <SolidColorBrush x:Key="Level.Builder.Background" Color="#FFF3E0"/>
    <SolidColorBrush x:Key="Level.Builder.Border"     Color="#FFB74D"/>
    <SolidColorBrush x:Key="Level.Builder.Shadow"     Color="#FF9800"/>
    <SolidColorBrush x:Key="Level.Builder.Ring1"      Color="#FFE0B2"/>
    <SolidColorBrush x:Key="Level.Builder.Ring2"      Color="#FFCC80"/>
    <SolidColorBrush x:Key="Level.Builder.Icon"       Color="#E65100"/>

    <!-- Achiever (Gold) -->
    <SolidColorBrush x:Key="Level.Achiever.Background" Color="#FFFDE7"/>
    <SolidColorBrush x:Key="Level.Achiever.Glow"       Color="#FFF9C4"/>
    <SolidColorBrush x:Key="Level.Achiever.Border1"    Color="#FFD54F"/>
    <SolidColorBrush x:Key="Level.Achiever.Border2"    Color="#FFA000"/>
    <SolidColorBrush x:Key="Level.Achiever.Shadow"     Color="#FFC107"/>
    <SolidColorBrush x:Key="Level.Achiever.Ring"       Color="#FFE082"/>
    <SolidColorBrush x:Key="Level.Achiever.Icon"       Color="#F9A825"/>

    <!-- Expert (Indigo) -->
    <SolidColorBrush x:Key="Level.Expert.Background" Color="#E8EAF6"/>
    <SolidColorBrush x:Key="Level.Expert.Glow"       Color="#C5CAE9"/>
    <SolidColorBrush x:Key="Level.Expert.Border1"    Color="#7986CB"/>
    <SolidColorBrush x:Key="Level.Expert.Border2"    Color="#283593"/>
    <SolidColorBrush x:Key="Level.Expert.Shadow"     Color="#3F51B5"/>
    <SolidColorBrush x:Key="Level.Expert.Ring1"      Color="#9FA8DA"/>
    <SolidColorBrush x:Key="Level.Expert.Ring2"      Color="#5C6BC0"/>
    <SolidColorBrush x:Key="Level.Expert.Icon1"      Color="#3949AB"/>
    <SolidColorBrush x:Key="Level.Expert.Icon2"      Color="#1A237E"/>

    <!-- Master (Deep Orange) -->
    <SolidColorBrush x:Key="Level.Master.Background" Color="#FBE9E7"/>
    <SolidColorBrush x:Key="Level.Master.Glow"       Color="#FFCCBC"/>
    <SolidColorBrush x:Key="Level.Master.Border1"    Color="#FF7043"/>
    <SolidColorBrush x:Key="Level.Master.Border2"    Color="#BF360C"/>
    <SolidColorBrush x:Key="Level.Master.Shadow"     Color="#FF5722"/>
    <SolidColorBrush x:Key="Level.Master.Ring1"      Color="#FF8A65"/>
    <SolidColorBrush x:Key="Level.Master.Ring2"      Color="#E64A19"/>
    <SolidColorBrush x:Key="Level.Master.Ring3"      Color="#FFAB91"/>

    <!-- Legend (Purple) -->
    <SolidColorBrush x:Key="Level.Legend.Background" Color="#F3E5F5"/>
    <SolidColorBrush x:Key="Level.Legend.Glow"       Color="#E1BEE7"/>
    <SolidColorBrush x:Key="Level.Legend.Border1"    Color="#CE93D8"/>
    <SolidColorBrush x:Key="Level.Legend.Border2"    Color="#7B1FA2"/>
    <SolidColorBrush x:Key="Level.Legend.Border3"    Color="#AB47BC"/>
    <SolidColorBrush x:Key="Level.Legend.Border4"    Color="#4A148C"/>
    <SolidColorBrush x:Key="Level.Legend.Shadow"     Color="#9C27B0"/>
    <SolidColorBrush x:Key="Level.Legend.Ring1"      Color="#CE93D8"/>
    <SolidColorBrush x:Key="Level.Legend.Ring2"      Color="#6A1B9A"/>
    <SolidColorBrush x:Key="Level.Legend.Ring3"      Color="#BA68C8"/>
    <SolidColorBrush x:Key="Level.Legend.Accent"     Color="#EDE7F6"/>


</ResourceDictionary>